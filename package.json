{
  "name": "ai-research-paper-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted research paper analysis with evidence-checked Q&A",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
